# FEISHU_* 前缀对应 Lark/Feishu 应用配置，保留以兼容现有部署。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-me

AGENTOS_URL=http://127.0.0.1:7777
AGENTOS_TOKEN=
AGENTOS_TARGET_TYPE=agent
AGENTOS_TARGET_ID=assistant
# Compatibility alias when AGENTOS_TARGET_TYPE=agent:
# AGENTOS_AGENT_ID=assistant

FEISHU_STATE_DB=.data/agno-feishu.sqlite3
FEISHU_ALLOWED_USER_IDS=
FEISHU_ALLOWED_CHAT_IDS=
# Group sessions: user (default, one context per member) or shared (one context per chat/thread)
FEISHU_GROUP_SESSION_MODE=user

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7788
